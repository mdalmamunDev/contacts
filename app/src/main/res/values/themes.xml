<!--suppress AndroidDomInspection -->
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Contacts" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/blue_dark</item>
        <item name="colorOnPrimary">@color/def_bg_color</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="MyTollBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/blue_dark</item>
        <item name="colorOnPrimary">@color/def_bg_color</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/def_bg_color</item>
        <!-- Status bar icon color. -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
    </style>



    <style name="text_small">
        <item name="android:textSize">@dimen/sp_13</item>
        <item name="android:textColor">@color/def_txt_color</item>
    </style>
    <style name="text_normal">
        <item name="android:textSize">@dimen/sp_16</item>
        <item name="android:textColor">@color/def_txt_color</item>
    </style>
    <style name="text_large">
        <item name="android:textSize">@dimen/sp_18</item>
        <item name="android:textColor">@color/def_txt_color</item>
    </style>
    <style name="text_largeX">
        <item name="android:textSize">@dimen/sp_24</item>
        <item name="android:textColor">@color/def_txt_color</item>
    </style>
    <style name="text_largeXX">
        <item name="android:textSize">@dimen/sp_35</item>
        <item name="android:textColor">@color/def_txt_color</item>
    </style>


    <style name="btn_smallX">
        <item name="android:layout_width">@dimen/dp_20</item>
        <item name="android:layout_height">@dimen/dp_20</item>
    </style>
    <style name="btn_small">
        <item name="android:layout_width">@dimen/dp_30</item>
        <item name="android:layout_height">@dimen/dp_30</item>
    </style>
    <style name="btn_normal">
        <item name="android:layout_width">@dimen/dp_40</item>
        <item name="android:layout_height">@dimen/dp_45</item>
    </style>
    <style name="btn_large">
        <item name="android:layout_width">@dimen/dp_60</item>
        <item name="android:layout_height">@dimen/dp_60</item>
        <item name="elevation"> @dimen/dp_7</item>
    </style>
    <style name="btn_largeX">
        <item name="android:layout_width">@dimen/dp_100</item>
        <item name="android:layout_height">@dimen/dp_100</item>
        <item name="elevation"> @dimen/dp_7</item>
    </style>


    <style name="edit_field_con">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/dp_20</item>
    </style>
    <style name="edit_field_icon_con">
        <item name="android:layout_width">@dimen/dp_25</item>
        <item name="android:layout_height">@dimen/dp_25</item>
        <item name="android:layout_marginTop">@dimen/dp_17</item>
        <item name="android:layout_marginStart">@dimen/dp_8</item>
        <item name="android:layout_marginEnd">@dimen/dp_8</item>
    </style>
    <style name="edit_field_middle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="edit_field_icon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:backgroundTint">@color/def_bg_color</item>
        <item name="android:contentDescription">@string/input_icon</item>
    </style>

</resources>