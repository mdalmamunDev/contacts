<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat  xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_70"
    android:background="#00000000"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/dp_4"
        android:layout_margin="@dimen/dp_3"
        app:cardUseCompatPadding="true"
        app:cardCornerRadius="@dimen/dp_8">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/def_bg_color2"
            android:layout_gravity="center_horizontal"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/main_menuBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_menu_24_d"
                android:backgroundTint="@color/def_bg_color2"/>

            <androidx.appcompat.widget.SearchView
                android:id="@+id/main_search_view"
                android:layout_width="@dimen/dp_270"
                android:layout_height="wrap_content"
                app:queryHint="Search contact...."
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent"
                />

            <androidx.appcompat.widget.AppCompatImageView
                style="@style/btn_small"
                android:layout_marginHorizontal="@dimen/dp_8"
                android:background="@drawable/def_btn_bg"
                android:src="@drawable/def_contact_img" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>
</androidx.appcompat.widget.LinearLayoutCompat>
