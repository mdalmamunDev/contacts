<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_300"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dp_15">

    <TextView
        android:id="@+id/details_opt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_phone_number"
        style="@style/text_normal"/>

    <RadioGroup
        android:id="@+id/radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

<!--        <include layout="@layout/details_action_single_option"/>-->
<!--        <include layout="@layout/details_action_single_option"/>-->
<!--        <include layout="@layout/details_action_single_option"/>-->
    </RadioGroup>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/details_btn_just_once"
            android:layout_width="@dimen/dp_75"
            android:layout_height="@dimen/dp_20"
            android:background="@drawable/button_on_press"
            android:text="@string/just_once"
            android:textAllCaps="false"
            style="@style/text_small"
            android:textColor="@color/def_txt_color_light"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/detail_btn_always"
            android:layout_width="@dimen/dp_65"
            android:layout_height="@dimen/dp_20"
            android:background="@drawable/button_on_press"
            android:text="@string/always"
            android:textAllCaps="false"
            style="@style/text_small"
            android:textColor="@color/def_txt_color_light"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>