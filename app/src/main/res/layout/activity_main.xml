<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:openDrawer="start"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/main_contents"/>


        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/def_bg_color2"
            android:layout_gravity="start"
            app:itemTextColor="@color/def_txt_color"
            app:itemIconSize="@dimen/dp_30"
            app:itemIconPadding="@dimen/dp_4"
            android:fitsSystemWindows="true">

            <include layout="@layout/nav_header_lay" />
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_100"
                android:orientation="vertical">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/nav_btn_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:paddingVertical="@dimen/dp_5"
                    android:background="@drawable/button_on_press"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/btn_small"
                        android:src="@drawable/def_contact_img_b" />

                    <TextView
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/contacts"
                        android:paddingStart="@dimen/dp_8"
                        tools:ignore="RtlSymmetry" />

                    <TextView
                        android:id="@+id/nav_contact_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/text_normal"
                        android:textColor="@color/blue"
                        android:text="@string/def_contact_count" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/nav_btn_fav_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:paddingVertical="@dimen/dp_5"
                    android:background="@drawable/button_on_press"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/btn_small"
                        android:src="@drawable/baseline_star_false_24" />

                    <TextView
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/favorites"
                        android:paddingStart="@dimen/dp_8"
                        tools:ignore="RtlSymmetry" />

                    <TextView
                        android:id="@+id/nav_fav_contact_count"
                        style="@style/text_normal"
                        android:textColor="@color/blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/def_contact_count" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/nav_btn_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:paddingVertical="@dimen/dp_5"
                    android:background="@drawable/button_on_press"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/btn_small"
                        android:src="@drawable/baseline_import_d" />

                    <TextView
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_"
                        android:paddingStart="@dimen/dp_8"
                        tools:ignore="RtlSymmetry" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/nav_btn_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:paddingVertical="@dimen/dp_5"
                    android:background="@drawable/button_on_press"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/btn_small"
                        android:src="@drawable/baseline_export_24_d" />

                    <TextView
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export"
                        android:paddingStart="@dimen/dp_8"
                        tools:ignore="RtlSymmetry" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:paddingVertical="@dimen/dp_5"
                    android:background="@drawable/button_on_press"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/btn_small"
                        android:src="@drawable/baseline_sort_24_d" />


                    <Spinner
                        android:id="@+id/nav_spinner_sort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/trans"
                        android:spinnerMode="dialog"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/nav_btn_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:paddingVertical="@dimen/dp_5"
                    android:background="@drawable/button_on_press"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/btn_small"
                        android:src="@drawable/baseline_help_outline_24_d" />

                    <TextView
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/help"
                        android:paddingStart="@dimen/dp_8"
                        tools:ignore="RtlSymmetry" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.navigation.NavigationView>

    </androidx.drawerlayout.widget.DrawerLayout>


</androidx.constraintlayout.widget.ConstraintLayout>